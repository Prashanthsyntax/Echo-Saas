    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "date-fns": "^4.4.0",
    "fabric": "^7.4.0",
    "geist": "^1.7.2",
    "groq-sdk": "^1.3.0",
    "lucide-react": "^1.21.0",
