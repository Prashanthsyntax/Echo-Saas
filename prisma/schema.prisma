generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum Plan {
  FREE
  PRO
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum ActivityType {
  MEMBER_JOINED
  MEMBER_LEFT
  MEMBER_REMOVED
  MEMBER_ROLE_CHANGED
  VIDEO_UPLOADED
  VIDEO_DELETED
  DOCUMENT_INGESTED
  KNOWLEDGE_GRAPH_CREATED
  CANVAS_UPDATED
  WORKFLOW_CREATED
  WORKSPACE_RENAMED
  INVITE_SENT
  CHAT_MESSAGE_SENT
}

model User {
  id              String          @id @default(cuid())
  clerkId         String          @unique
  email           String          @unique
  name            String?
  imageUrl        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  memberships     Membership[]
  videos          Video[]
  comments        Comment[]
  agentKeys       AgentKey[]
  ragFeedback     RagFeedback[]
  chunkScores     ChunkScore[]
  chatSessions    ChatSession[]
  knowledgeGraphs KnowledgeGraph[]
  canvasStates    CanvasState[]
  activityLogs    ActivityLog[]
  presenceSessions PresenceSession[]
}

model Workspace {
  id               String             @id @default(cuid())
  name             String
  description      String?
  plan             Plan               @default(FREE)
  stripeCustomerId String?            @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  memberships      Membership[]
  videos           Video[]
  folders          Folder[]
  subscription     Subscription?
  invites          Invite[]
  chatSessions     ChatSession[]
  knowledgeGraphs  KnowledgeGraph[]
  canvasStates     CanvasState[]
  activityLogs     ActivityLog[]
  settings         WorkspaceSettings?
  presenceSessions PresenceSession[]
}

model Membership {
  id          String    @id @default(cuid())
  role        Role      @default(VIEWER)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@unique([userId, workspaceId])
}

model Folder {
  id          String    @id @default(cuid())
  name        String
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  parent      Folder?   @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentId    String?
  children    Folder[]  @relation("FolderToFolder")

  videos      Video[]
}

model Video {
  id              String      @id @default(cuid())
  title           String      @default("Untitled Video")
  description     String?
  url             String?
  thumbnailUrl    String?
  duration        Int?
  status          VideoStatus @default(UPLOADING)

  // existing transcript (raw whisper output)
  transcript      String?     @db.Text

  // new structured fields
  structuredNotes String?     @db.Text  // full markdown notes
  summary         String?               // 2-3 sentence summary
  keyPoints       String[]              // bullet point key takeaways
  actionItems     String[]              // action items extracted
  topics          String[]              // main topic tags
  language        String?               // detected language
  speakerCount    Int?                  // estimated number of speakers
  notesEditedAt   DateTime?             // when user last manually edited notes

  viewCount       Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId     String

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String

  folder          Folder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId        String?

  comments        Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  timestamp Int?
  createdAt DateTime @default(now())

  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId   String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

model Subscription {
  id                   String    @id @default(cuid())
  stripeSubscriptionId String    @unique
  status               String
  plan                 Plan      @default(FREE)
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId          String    @unique
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  role        Role      @default(VIEWER)
  token       String    @unique @default(cuid())
  accepted    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
}

model AgentKey {
  id        String   @id @default(cuid())
  provider  String
  keyHash   String
  keyHint   String
  model     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([userId, provider])
}

model RagFeedback {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sources   String[]
  rating    Int
  chunkIds  String[]
  modelUsed String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}
model ChunkScore {
  id         String   @id @default(cuid())
  sourceDoc  String
  chunkText  String   @db.Text
  chunkHash  String
  score      Float    @default(0)
  usageCount Int      @default(0)
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String

  @@unique([userId, sourceDoc, chunkHash])
}

model ChatSession {
  id          String        @id @default(cuid())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  messages    ChatMessage[]

  @@unique([userId, workspaceId])
}

model ChatMessage {
  id          String      @id @default(cuid())
  role        String
  content     String      @db.Text
  sources     String[]
  modelUsed   String?
  contextUsed Boolean     @default(false)
  chunkIds    String[]
  feedback    Int?
  createdAt   DateTime    @default(now())

  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String
}

model KnowledgeGraph {
  id             String    @id @default(cuid())
  title          String
  summary        String    @db.Text
  graphData      Json
  nodePositions  Json
  zoomLevel      Float     @default(1)
  panX           Float     @default(0)
  panY           Float     @default(0)
  selectedNodeId String?
  sourceFile     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId    String

  @@unique([userId, workspaceId])
}

model CanvasState {
  id          String    @id @default(cuid())
  canvasData  Json
  viewportX   Float     @default(0)
  viewportY   Float     @default(0)
  zoomLevel   Float     @default(1)
  objectCount Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@unique([userId, workspaceId])
}

model ActivityLog {
  id          String       @id @default(cuid())
  type        ActivityType
  description String
  metadata    Json?
  createdAt   DateTime     @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
}

model WorkspaceSettings {
  id                String    @id @default(cuid())
  allowMemberInvite Boolean   @default(false)
  allowMemberExport Boolean   @default(true)
  defaultRole       Role      @default(VIEWER)
  updatedAt         DateTime  @updatedAt

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId       String    @unique
}

model PresenceSession {
  id          String   @id @default(cuid())
  page        String   // "/dashboard", "/canvas", "/chat", etc.
  lastSeen    DateTime @default(now())
  createdAt   DateTime @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@unique([userId, workspaceId])
}