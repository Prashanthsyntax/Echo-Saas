generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum Plan {
  FREE
  PRO
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum ActivityType {
  MEMBER_JOINED
  MEMBER_LEFT
  MEMBER_REMOVED
  MEMBER_ROLE_CHANGED
  VIDEO_UPLOADED
  VIDEO_DELETED
  DOCUMENT_INGESTED
  KNOWLEDGE_GRAPH_CREATED
  CANVAS_UPDATED
  WORKFLOW_CREATED
  WORKSPACE_RENAMED
  INVITE_SENT
  CHAT_MESSAGE_SENT
}

model User {
  id              String          @id @default(cuid())
  clerkId         String          @unique
  email           String          @unique
  name            String?
  imageUrl        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  memberships     Membership[]
  videos          Video[]
  comments        Comment[]
  agentKeys       AgentKey[]
  ragFeedback     RagFeedback[]
  chunkScores     ChunkScore[]
  chatSessions    ChatSession[]
  knowledgeGraphs KnowledgeGraph[]
  canvasStates    CanvasState[]
  activityLogs    ActivityLog[]
  presenceSessions PresenceSession[]
  kanbanCards         KanbanCard[]
  kanbanCardsCreated  KanbanCard[]    @relation("KanbanCardCreator")
  kanbanComments      KanbanComment[]
  createdEvents   SchedulerEvent[] @relation("EventCreator")
  eventAttendees  EventAttendee[]
  createdConversations    Conversation[]            @relation("ConversationCreator")
  conversationParticipants ConversationParticipant[]
  sentMessages            Message[]                 @relation("MessageSender")
  messageMentions         MessageMention[]
  messageReactions        MessageReaction[]
  messageReadReceipts     MessageReadReceipt[]
  pollVotes               PollVote[]
}

model Workspace {
  id               String             @id @default(cuid())
  name             String
  description      String?
  plan             Plan               @default(FREE)
  stripeCustomerId String?            @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  memberships      Membership[]
  videos           Video[]
  folders          Folder[]
  subscription     Subscription?
  invites          Invite[]
  chatSessions     ChatSession[]
  knowledgeGraphs  KnowledgeGraph[]
  canvasStates     CanvasState[]
  activityLogs     ActivityLog[]
  settings         WorkspaceSettings?
  presenceSessions PresenceSession[]
  decayLogs       KnowledgeDecayLog[]
  contradictions  KnowledgeContradiction[]
  kanbanBoard KanbanBoard?
  events SchedulerEvent[]
  sentraRepos    SentraRepo[]
  sentraSettings SentraSettings?
  sentraPolicies  SentraPolicy[]
  conversations Conversation[]
}

model Membership {
  id          String    @id @default(cuid())
  role        Role      @default(VIEWER)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@unique([userId, workspaceId])
}

model Folder {
  id          String    @id @default(cuid())
  name        String
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  parent      Folder?   @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentId    String?
  children    Folder[]  @relation("FolderToFolder")

  videos      Video[]
}

model Video {
  id              String      @id @default(cuid())
  title           String      @default("Untitled Video")
  description     String?
  url             String?
  thumbnailUrl    String?
  duration        Int?
  status          VideoStatus @default(UPLOADING)

  // existing transcript (raw whisper output)
  transcript      String?     @db.Text

  // new structured fields
  structuredNotes String?     @db.Text  // full markdown notes
  summary         String?               // 2-3 sentence summary
  keyPoints       String[]              // bullet point key takeaways
  actionItems     String[]              // action items extracted
  topics          String[]              // main topic tags
  language        String?               // detected language
  speakerCount    Int?                  // estimated number of speakers
  notesEditedAt   DateTime?             // when user last manually edited notes

  viewCount       Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId     String

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String

  folder          Folder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId        String?

  comments        Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  timestamp Int?
  createdAt DateTime @default(now())

  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId   String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

model Subscription {
  id                   String    @id @default(cuid())
  stripeSubscriptionId String    @unique
  status               String
  plan                 Plan      @default(FREE)
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId          String    @unique
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  role        Role      @default(VIEWER)
  token       String    @unique @default(cuid())
  accepted    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
}

model AgentKey {
  id        String   @id @default(cuid())
  provider  String
  keyHash   String
  keyHint   String
  model     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([userId, provider])
}

model RagFeedback {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sources   String[]
  rating    Int
  chunkIds  String[]
  modelUsed String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}
model ChunkScore {
  id         String   @id @default(cuid())
  sourceDoc  String
  chunkText  String   @db.Text
  chunkHash  String
  score      Float    @default(0)
  usageCount Int      @default(0)
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String

  @@unique([userId, sourceDoc, chunkHash])
}

model ChatSession {
  id          String        @id @default(cuid())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  messages    ChatMessage[]

  @@unique([userId, workspaceId])
}

model ChatMessage {
  id          String      @id @default(cuid())
  role        String
  content     String      @db.Text
  sources     String[]
  modelUsed   String?
  contextUsed Boolean     @default(false)
  chunkIds    String[]
  feedback    Int?
  createdAt   DateTime    @default(now())

  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String
}

model KnowledgeGraph {
  id             String    @id @default(cuid())
  title          String
  summary        String    @db.Text
  graphData      Json
  nodePositions  Json
  zoomLevel      Float     @default(1)
  panX           Float     @default(0)
  panY           Float     @default(0)
  selectedNodeId String?
  sourceFile     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId    String

  @@unique([userId, workspaceId])
}

model CanvasState {
  id          String    @id @default(cuid())
  canvasData  Json
  viewportX   Float     @default(0)
  viewportY   Float     @default(0)
  zoomLevel   Float     @default(1)
  objectCount Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@unique([userId, workspaceId])
}

model ActivityLog {
  id          String       @id @default(cuid())
  type        ActivityType
  description String
  metadata    Json?
  createdAt   DateTime     @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
}

model WorkspaceSettings {
  id                String    @id @default(cuid())
  allowMemberInvite Boolean   @default(false)
  allowMemberExport Boolean   @default(true)
  defaultRole       Role      @default(VIEWER)
  updatedAt         DateTime  @updatedAt

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId       String    @unique
}

model PresenceSession {
  id          String   @id @default(cuid())
  page        String   // "/dashboard", "/canvas", "/chat", etc.
  lastSeen    DateTime @default(now())
  createdAt   DateTime @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@unique([userId, workspaceId])
}

enum ContradictionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ContradictionStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model KnowledgeDecayLog {
  id            String   @id @default(cuid())
  sourceDoc     String   // document name
  docType       String   // pdf, url, transcript, docx, txt
  chunkCount    Int      @default(0)
  avgDecayScore Float    @default(1.0)   // 0.0 = fully stale, 1.0 = fresh
  halfLifeDays  Int      // configured half-life for this doc type
  ingestedAt    DateTime // when it was first ingested
  lastCheckedAt DateTime @default(now())
  isFlagged     Boolean  @default(false)
  flagReason    String?

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId   String

  @@unique([workspaceId, sourceDoc])
}

model KnowledgeContradiction {
  id              String                @id @default(cuid())
  sourceDocA      String                // older document
  sourceDocB      String                // newer document
  chunkTextA      String                @db.Text
  chunkTextB      String                @db.Text
  similarityScore Float                 // cosine similarity that triggered check
  llmVerdict      String                @db.Text  // LLM explanation
  severity        ContradictionSeverity @default(MEDIUM)
  status          ContradictionStatus   @default(OPEN)
  resolvedBy      String?               // userId who resolved
  resolvedAt      DateTime?
  createdAt       DateTime              @default(now())

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId     String
}

enum KanbanPriority {
  LOW
  MEDIUM
  HIGH
}

model KanbanBoard {
  id          String        @id @default(cuid())
  name        String        @default("Platform board")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String        @unique

  cards       KanbanCard[]
}

model KanbanCard {
  id          String        @id @default(cuid())
  ticketId    String        // e.g. "HAL-241" — auto-generated
  title       String
  description String?       @db.Text
  column      String        // "todo" | "inprogress" | "testing" | "done"
  position    Int           @default(0)
  label       String?       // "Billing" | "Platform" | "API" | "Identity" | "Growth"
  labelColor  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  board       KanbanBoard   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId     String

  assignee    User?         @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId  String?

  creator     User          @relation("KanbanCardCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId   String

  comments    KanbanComment[]
  attachments KanbanAttachment[]
}

model KanbanComment {
  id        String     @id @default(cuid())
  content   String     @db.Text
  createdAt DateTime   @default(now())

  card      KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId    String

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

model KanbanAttachment {
  id        String     @id @default(cuid())
  name      String
  url       String
  createdAt DateTime   @default(now())

  card      KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId    String
}

enum EventStatus {
  UPCOMING
  CONFIRMED
  TENTATIVE
}

model SchedulerEvent {
  id          String      @id @default(cuid())
  title       String
  date        DateTime    // date only (store as midnight UTC)
  startTime   String      // "2:30 pm" — stored as string for simplicity
  endTime     String?
  location    String?
  status      EventStatus @default(UPCOMING)
  isPersonal  Boolean     @default(false)  // false = workspace, true = personal
  needsReply  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  creator     User        @relation("EventCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId   String

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  attendees   EventAttendee[]
}

model EventAttendee {
  id       String         @id @default(cuid())
  replied  Boolean        @default(false)
  accepted Boolean?       // null = no reply, true = accepted, false = declined

  event    SchedulerEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId  String

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String

  @@unique([eventId, userId])
}

enum ScanStatus {
  PENDING
  SCANNING
  COMPLETED
  FAILED
}

enum FindingSeverity {
  CRITICAL
  WARNING
  INFO
}

enum FindingStatus {
  OPEN
  IN_REVIEW
  FIXED
  IGNORED
}

model SentraRepo {
  id            String      @id @default(cuid())
  githubUrl     String
  owner         String
  repoName      String
  fullName      String      // owner/repo
  description   String?
  isPrivate     Boolean     @default(false)
  defaultBranch String      @default("main")
  language      String?
  languages     Json?       // { TypeScript: 60, Python: 40 }
  stars         Int         @default(0)
  forks         Int         @default(0)
  openIssues    Int         @default(0)
  openPRs       Int         @default(0)
  totalCommits  Int         @default(0)
  lastScanAt    DateTime?
  scanStatus    ScanStatus  @default(PENDING)
  riskScore     String?     // A+, B, C etc
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId   String

  findings      SentraFinding[]
  commits       SentraCommit[]
  scans         SentraScan[]

  @@unique([workspaceId, fullName])

  attackPaths     SentraAttackPath[]
  secretFindings  SentraSecretFinding[]
  scaFindings     SentraSCAFinding[]
  commitDiffs     SentraCommitSecurityDiff[]
  scanJobs        SentraScanJob[]
}

model SentraScan {
  id            String      @id @default(cuid())
  status        ScanStatus  @default(PENDING)
  triggeredBy   String      // "manual" | "push" | "nightly"
  branch        String      @default("main")
  filesScanned  Int         @default(0)
  findingsCount Int         @default(0)
  duration      Int?        // seconds
  errorMessage  String?
  createdAt     DateTime    @default(now())
  completedAt   DateTime?

  repo          SentraRepo  @relation(fields: [repoId], references: [id], onDelete: Cascade)
  repoId        String

  findings      SentraFinding[]
  attackPaths     SentraAttackPath[]
  secretFindings  SentraSecretFinding[]
  scaFindings     SentraSCAFinding[]
  agentRuns       SentraAgentRun[]
  job             SentraScanJob?
}

model SentraFinding {
  id              String          @id @default(cuid())
  severity        FindingSeverity
  title           String
  description     String          @db.Text
  filePath        String
  lineNumber      Int?
  cwe             String?         // CWE-89, CWE-79 etc
  rule            String?
  snippet         String?         @db.Text  // vulnerable code snippet
  aiFix             String?         @db.Text  // AI suggested fix
  diffBefore      String?         @db.Text
  diffAfter       String?         @db.Text
  status          FindingStatus   @default(OPEN)
  autoFixed       Boolean         @default(false)
  ignoreReason    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  repo            SentraRepo      @relation(fields: [repoId], references: [id], onDelete: Cascade)
  repoId          String

  scan            SentraScan      @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId          String
  fix             SentraFixVerification?
}

model SentraCommit {
  id          String     @id @default(cuid())
  sha         String
  message     String
  authorName  String
  authorEmail String
  branch      String     @default("main")
  additions   Int        @default(0)
  deletions   Int        @default(0)
  filesChanged Int       @default(0)
  committedAt DateTime
  createdAt   DateTime   @default(now())

  repo        SentraRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  repoId      String

  @@unique([repoId, sha])
}

model SentraSettings {
  id                  String   @id @default(cuid())
  scanOnPush          Boolean  @default(true)
  nightlyScan         Boolean  @default(true)
  autoFixLowRisk      Boolean  @default(false)
  emailAlerts         Boolean  @default(true)
  slackAlerts         Boolean  @default(false)
  alertEmail          String?
  slackWebhookUrl     String?
  githubToken         String?  // encrypted
  updatedAt           DateTime @updatedAt

  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId         String    @unique
}

enum AttackPathSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum FixStatus {
  PENDING
  GENERATED
  PR_CREATED
  VERIFIED
  FAILED
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum ScanLayer {
  SAST
  SECRETS
  SCA
  OWASP
  API_SECURITY
  SUPPLY_CHAIN
  AI_REASONING
}

// Multi-step attack path identified by AI reasoning
model SentraAttackPath {
  id            String              @id @default(cuid())
  title         String
  description   String              @db.Text
  severity      AttackPathSeverity
  steps         Json                // array of {stepNumber, file, line, action, description}
  affectedFiles Json                // string[]
  attackVector  String?             // "network" | "local" | "physical"
  cveIds        Json?               // string[]
  cvssScore     Float?
  exploitability String?            // "High" | "Medium" | "Low"
  businessImpact String?
  remediation   String?             @db.Text
  isVerified    Boolean             @default(false)
  createdAt     DateTime            @default(now())

  scan          SentraScan          @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId        String

  repo          SentraRepo          @relation(fields: [repoId], references: [id], onDelete: Cascade)
  repoId        String
}

// Secrets / credentials found in code
model SentraSecretFinding {
  id          String        @id @default(cuid())
  secretType  String        // "API_KEY" | "PASSWORD" | "TOKEN" | "PRIVATE_KEY" | "CONNECTION_STRING"
  filePath    String
  lineNumber  Int?
  entropy     Float?        // Shannon entropy score
  matchedRule String?
  snippet     String?       @db.Text  // redacted — first/last 4 chars only
  severity    FindingSeverity
  isVerified  Boolean       @default(false) // confirmed real secret vs false positive
  status      FindingStatus @default(OPEN)
  createdAt   DateTime      @default(now())

  scan        SentraScan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId      String

  repo        SentraRepo    @relation(fields: [repoId], references: [id], onDelete: Cascade)
  repoId      String
}

// Software Composition Analysis — vulnerable dependencies
model SentraSCAFinding {
  id              String        @id @default(cuid())
  packageName     String
  packageVersion  String
  ecosystem       String        // "npm" | "pypi" | "maven" | "go"
  vulnerabilityId String?       // CVE-XXXX-XXXXX or GHSA-xxx
  severity        FindingSeverity
  title           String
  description     String?       @db.Text
  fixedVersion    String?
  manifestFile    String        // package.json, requirements.txt etc
  isDirect        Boolean       @default(true)
  isTransitive    Boolean       @default(false)
  status          FindingStatus @default(OPEN)
  createdAt       DateTime      @default(now())

  scan            SentraScan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId          String

  repo            SentraRepo    @relation(fields: [repoId], references: [id], onDelete: Cascade)
  repoId          String
}

// Fix generation + PR creation + verification result
model SentraFixVerification {
  id                String      @id @default(cuid())
  status            FixStatus   @default(PENDING)
  originalCode      String?     @db.Text
  fixedCode         String?     @db.Text
  patchDiff         String?     @db.Text
  prUrl             String?
  prNumber          Int?
  branchName        String?
  verificationStatus String?    // "RESOLVED" | "UNRESOLVED" | "REGRESSION"
  verificationNotes String?     @db.Text
  reScanFindingCount Int        @default(0)
  createdAt         DateTime    @default(now())
  verifiedAt        DateTime?

  finding           SentraFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  findingId         String        @unique
}

// Per-commit security diff — tracks security changes over time
model SentraCommitSecurityDiff {
  id                  String   @id @default(cuid())
  sha                 String
  parentSha           String?
  newFindings         Int      @default(0)
  resolvedFindings    Int      @default(0)
  newCriticals        Int      @default(0)
  newSecrets          Int      @default(0)
  riskScoreBefore     String?
  riskScoreAfter      String?
  isRegression        Boolean  @default(false)  // worse than parent
  securityDelta       Int      @default(0)       // positive = more issues
  aiSummary           String?  @db.Text
  committedAt         DateTime
  createdAt           DateTime @default(now())

  repo                SentraRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  repoId              String
}

// Async scan job queue
model SentraScanJob {
  id          String    @id @default(cuid())
  status      JobStatus @default(QUEUED)
  layers      Json      // ScanLayer[] — which scan types to run
  priority    Int       @default(5) // 1-10
  triggeredBy String    // "manual" | "push" | "pr" | "nightly" | "cli"
  startedAt   DateTime?
  completedAt DateTime?
  errorMessage String?
  createdAt   DateTime  @default(now())

  scan        SentraScan  @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId      String      @unique

  repo        SentraRepo  @relation(fields: [repoId], references: [id], onDelete: Cascade)
  repoId      String
}

// AI agent run log — which agent ran, what it found
model SentraAgentRun {
  id           String   @id @default(cuid())
  agentType    String   // "VulnDetect" | "CodeFlow" | "AttackPath" | "Risk" | "Explain" | "Fix" | "Verify"
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  durationMs   Int      @default(0)
  findingsIn   Int      @default(0)  // findings fed in
  findingsOut  Int      @default(0)  // findings produced/kept
  rawOutput    String?  @db.Text
  error        String?
  createdAt    DateTime @default(now())

  scan         SentraScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId       String
}

// Workspace security policies
model SentraPolicy {
  id               String   @id @default(cuid())
  name             String
  description      String?
  blockOnCritical  Boolean  @default(true)   // block PR merge if critical found
  blockOnSecrets   Boolean  @default(true)   // block PR if secrets found
  maxCriticals     Int      @default(0)      // max allowed criticals before blocking
  maxWarnings      Int      @default(10)
  requireVerify    Boolean  @default(false)  // require AI fix verification
  enforcedBranches Json     @default("[]")  // string[] — e.g. ["main", "prod"]
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId      String
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum MessageType {
  TEXT
  FILE
  VOICE
  POLL
  CODE
  SYSTEM
}

enum DeliveryStatus {
  SENT
  DELIVERED
  READ
}

model Conversation {
  id          String              @id @default(cuid())
  subject     String
  isGroup     Boolean             @default(false)
  status      ConversationStatus  @default(ACTIVE)
  lastMessageAt DateTime?
  lastMessagePreview String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  creator     User                @relation("ConversationCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId   String

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  isStarred      Boolean      @default(false)
  isMuted        Boolean      @default(false)
  lastReadAt     DateTime?
  unreadCount    Int          @default(0)
  joinedAt       DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String

  @@unique([conversationId, userId])
}

model Message {
  id             String         @id @default(cuid())
  content        String         @db.Text
  type           MessageType    @default(TEXT)
  deliveryStatus DeliveryStatus @default(SENT)
  isEdited       Boolean        @default(false)
  editedAt       DateTime?
  isDeleted      Boolean        @default(false)
  metadata       Json?          // for code: {language}, for voice: {duration}, for system: {action}
  createdAt      DateTime       @default(now())

  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  sender         User           @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String

  // threading
  parentMessage  Message?       @relation("MessageThread", fields: [parentId], references: [id])
  parentId       String?
  replies        Message[]      @relation("MessageThread")

  // mentions
  mentions       MessageMention[]
  reactions      MessageReaction[]
  attachments    MessageAttachment[]
  readReceipts   MessageReadReceipt[]
  poll           Poll?
}

model MessageMention {
  id        String  @id @default(cuid())
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([messageId, userId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  emoji     String
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([messageId, userId, emoji])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  name      String
  url       String
  size      Int      // bytes
  mimeType  String
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
}

model MessageReadReceipt {
  id       String   @id @default(cuid())
  readAt   DateTime @default(now())

  message  Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String

  @@unique([messageId, userId])
}

model Poll {
  id           String       @id @default(cuid())
  question     String
  allowMultiple Boolean     @default(false)
  endsAt       DateTime?
  createdAt    DateTime     @default(now())

  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId    String       @unique

  options      PollOption[]
}

model PollOption {
  id     String     @id @default(cuid())
  text   String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId String
  votes  PollVote[]
}

model PollVote {
  id       String     @id @default(cuid())
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String

  @@unique([optionId, userId])
}